          "type": "element",
          "tag": "code",
          "attrs": {},
          "children": [
            {
              "type": "text",
              "value": ".conductor/settings.local.toml"
            }
          ]
        },
        {
          "type": "text",
          "value": " for project changes that should apply on your Mac. Use "
